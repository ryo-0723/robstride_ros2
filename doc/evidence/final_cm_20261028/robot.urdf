<robot name="final_encoder"><link name="base"/><link name="tip"/><joint name="robstride_joint" type="continuous"><parent link="base"/><child link="tip"/><axis xyz="0 0 1"/></joint><ros2_control name="final_system" type="system"><hardware><plugin>robstride_ros2/RobStrideSystem</plugin><param name="host_can_id">253</param><param name="set_zero_on_activate">false</param><param name="fail_on_feedback_timeout">false</param><param name="feedback_timeout_ms">500</param><param name="run_mode_recovery_timeout_ms">120000</param><param name="startup_retries">3</param></hardware><joint name="robstride_joint"><param name="can_id">33</param><param name="can_timeout_ticks">4000</param><param name="model">EL05</param><param name="kp">5</param><param name="kd">1</param><param name="command_velocity_min">-1</param><param name="command_velocity_max">1</param><param name="command_effort_min">-1</param><param name="command_effort_max">1</param><command_interface name="position"/><command_interface name="velocity"/><command_interface name="effort"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint></ros2_control></robot>